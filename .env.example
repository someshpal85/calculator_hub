# Calculator ProHub — environment template
# Copy to .env.local and fill in your real values. Never commit .env.local.

# Required for correct canonical URLs, sitemap, and social sharing.
# Example: https://calculator-prohub.com
NEXT_PUBLIC_SITE_URL=

# Optional — analytics endpoint (leave blank to disable).
# Example: https://plausible.example.com/api/event
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
